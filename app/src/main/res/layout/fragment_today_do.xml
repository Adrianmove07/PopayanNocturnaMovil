<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    tools:context=".fragment.TodayDoFragment"> <TextView
    android:id="@+id/tv_title_today_do"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="32dp" android:layout_marginEnd="24dp"
    android:text="¿Qué quieres hacer hoy?"
    android:textSize="26sp" android:textStyle="bold"
    android:textColor="@color/black" android:gravity="center"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories_today_do"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title_today_do"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_category" />

</androidx.constraintlayout.widget.ConstraintLayout>