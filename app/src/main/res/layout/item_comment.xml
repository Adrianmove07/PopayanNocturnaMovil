<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_dark"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Nombre del usuario -->
    <TextView
        android:id="@+id/tvCommentUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del usuario"
        android:textStyle="bold"
        android:textColor="@android:color/background_dark"
        android:textSize="16sp" />

    <!-- Contenido del comentario -->
    <TextView
        android:id="@+id/tvCommentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contenido del comentario"
        android:textColor="@android:color/background_dark"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <!-- Fecha -->
    <TextView
        android:id="@+id/tvCommentDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025-07-18"
        android:textSize="12sp"
        android:textColor="#BBBBBB"
        android:layout_marginTop="6dp" />

    <!-- Estado del comentario (opcional) -->
    <TextView
        android:id="@+id/tvCommentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pendiente de aprobación"
        android:textColor="#FFA726"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

</LinearLayout>
